{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TabPlayer", "version": "1.0.0", "identifier": "dev.tabplayer.desktop",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "TabPlayer", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600 }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; script-src 'self' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; media-src 'self' blob:", "devCsp": null }
  },
  "bundle": { "active": true, "targets": "all",
    "fileAssociations": [
      { "ext": ["tabplayer"], "name": "TabPlayer.Project", "description": "TabPlayer project", "role": "Editor", "mimeType": "application/x-tabplayer" },
      { "ext": ["gp", "gpx", "gp5", "gp4", "gp3"], "name": "TabPlayer.GuitarProScore", "description": "Guitar Pro score", "role": "Editor" }
    ], "resources": { "resources/audio/": "audio/", "resources/library/": "library/", "resources/cabinet-irs/": "cabinet-irs/" }, "windows": { "webviewInstallMode": { "type": "offlineInstaller" } }, "icon": ["icons/icon.png","icons/icon.ico","icons/icon.icns"] }
}
